    "# === SAVE FINAL FEATURES ===\n",
    "\n",
    "np.savez_compressed(f'{OUTPUT}/utterance_features.npz',\n",
    "                    features=np.array(all_features),\n",
    "                    labels=np.array(all_labels),\n",
    "                    vids=np.array(all_vids))\n",
    "\n",
    "print(f'Saved: {OUTPUT}/utterance_features.npz')"
   ]
